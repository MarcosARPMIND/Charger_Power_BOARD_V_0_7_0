  (constraint creepage (min 3.0mm))
  (condition "((A.NetName == '/Line1_RelayIN' || A.NetName == '/Line2_RelayIN' || A.NetName == '/Line3_RelayIN' || A.NetName == '/Line_1' || A.NetName == '/Line_1_OUT' || A.NetName == '/Line_2' || A.NetName == '/Line_2_OUT' || A.NetName == '/Line_3' || A.NetName == '/Line_3_OUT' || A.NetName == '/Neutral_Line' || A.NetName == '/Neutral_Line_OUT' || A.NetName == '/Neutral_RelayIN' || A.NetName == '/Welding_Contact_Detector/+3V_n' || A.NetName == '/Welding_Contact_Detector/+5V_n' || A.NetName == '/Welding_Contact_Detector1/+3V_n' || A.NetName == '/Welding_Contact_Detector1/+5V_n' || A.NetName == '/Welding_Contact_Detector2/+3V_n' || A.NetName == '/Welding_Contact_Detector2/+5V_n' || A.NetName == '/Welding_Contact_Detector3/+3V_n' || A.NetName == '/Welding_Contact_Detector3/+5V_n' || A.NetName == 'Net-(C23-Pad2)' || A.NetName == 'Net-(C26-Pad2)' || A.NetName == 'Net-(C37-Pad2)' || A.NetName == 'Net-(C61-Pad2)' || A.NetName == 'Net-(D16-A)' || A.NetName == 'Net-(D25-A)' || A.NetName == 'Net-(D25-K)' || A.NetName == 'Net-(D29A-K)' || A.NetName == 'Net-(D31-A)' || A.NetName == 'Net-(D31-K)' || A.NetName == 'Net-(D49A-K)' || A.NetName == 'Net-(D51-A)' || A.NetName == 'Net-(D51-K)' || A.NetName == 'Net-(D53A-K)' || A.NetName == 'Net-(D55-A)' || A.NetName == 'Net-(D55-K)' || A.NetName == 'Net-(IC15-E)' || A.NetName == 'Net-(IC17-OUT)' || A.NetName == 'Net-(IC17-VIN+)' || A.NetName == 'Net-(IC17-VIN-)' || A.NetName == 'Net-(IC18-A)' || A.NetName == 'Net-(IC21-E)' || A.NetName == 'Net-(IC23-OUT)' || A.NetName == 'Net-(IC23-VIN+)' || A.NetName == 'Net-(IC23-VIN-)' || A.NetName == 'Net-(IC24-A)' || A.NetName == 'Net-(IC26-E)' || A.NetName == 'Net-(IC45-OUT)' || A.NetName == 'Net-(IC45-VIN+)' || A.NetName == 'Net-(IC45-VIN-)' || A.NetName == 'Net-(IC46-A)' || A.NetName == 'Net-(IC48-E)' || A.NetName == 'Net-(IC50-OUT)' || A.NetName == 'Net-(IC50-VIN+)' || A.NetName == 'Net-(IC50-VIN-)' || A.NetName == 'Net-(IC51-A)' || A.NetName == 'Net-(R100-Pad1)' || A.NetName == 'Net-(R100-Pad